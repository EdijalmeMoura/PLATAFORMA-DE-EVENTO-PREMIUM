# ============================================================
#  PLATAFORMA DE EVENTO PREMIUM — Configuração de ambiente
#  Copie este arquivo para ".env" e ajuste conforme sua hospedagem.
#  Na maioria das hospedagens simples (cPanel) basta enviar os
#  arquivos e acessar install.php — o SQLite funciona sem config.
# ============================================================

APP_NAME="Plataforma de Evento Premium"
APP_ENV=production
APP_URL=https://seudominio.com.br
APP_KEY=
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR

# Banco de dados: "sqlite" (padrão, zero-config) ou "mysql"
DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

# MySQL (preencha apenas se DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evento_premium
DB_USER=root
DB_PASS=
DB_PREFIX=

# Segurança
SESSION_LIFETIME=120
HASH_COST=12

# Fila / Cron — token secreto para cron.php
CRON_TOKEN=troque-este-token-aqui

# E-mail padrão (pode ser configurado pelo painel depois)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENC=tls
MAIL_FROM=
MAIL_FROM_NAME=

# WhatsApp Cloud API (pode ser configurado pelo painel depois)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_NUMBER=
